<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="EcommerceSuite">
    <listeners>
        <listener class-name="listeners.TestNGListener"/>
    </listeners>

    <test name="LoginTests">
        <classes>
            <class name="tests.loginTest"/>
        </classes>
    </test>
    <test name="ProductNameCheck">
        <classes>
            <class name="tests.checkproductname"/>
        </classes>
    </test>
    <test name="CartFunctionalityTest">
        <classes>
            <class name="tests.CartFunctionalityTest"></class>
        </classes>
    </test>
</suite>